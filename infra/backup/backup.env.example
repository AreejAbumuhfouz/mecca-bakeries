# /etc/mecca/backup.env — readable by root and the mecca user only (chmod 600)
DATABASE_URL=postgresql://mecca:CHANGE_ME@localhost:5432/mecca_bakeries
BACKUP_DIR=/var/backups/mecca
UPLOAD_DIR=/opt/mecca/apps/api/uploads
KEEP_DAYS=14
# Off-site copy: any rclone remote set up with `rclone config`, e.g. b2:mecca-backups or gdrive:mecca-backups
RCLONE_REMOTE=
# Optional: a healthchecks.io ping URL — you get an email if a daily backup does not arrive
HEALTHCHECK_URL=
