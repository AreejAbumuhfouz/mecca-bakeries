{
  "name": "mecca-bakeries",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @mecca/api dev",
    "dev:web": "pnpm --filter @mecca/web dev",
    "dev:mobile": "pnpm --filter @mecca/mobile start",
    "bootstrap": "pnpm --filter @mecca/shared build && pnpm --filter @mecca/api db:migrate && pnpm --filter @mecca/api db:seed",
    "demo": "pnpm --filter @mecca/api db:demo",
    "demo:reset": "pnpm --filter @mecca/api db:demo --reset",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n/extract.cjs --check",
    "i18n:missing": "node scripts/i18n/extract.cjs --json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
