NODE_ENV=development
PORT=4000
# Local PostgreSQL (Homebrew). Create the DBs once with: createdb mecca_bakeries && createdb mecca_bakeries_test
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/mecca_bakeries
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Amman

# Auth — generate each secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_PEPPER=change-me-to-another-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Google Sign-In client IDs (web, iOS, Android), comma separated. Leave empty to disable Google login.
GOOGLE_CLIENT_IDS=

# Email for login codes. Leave SMTP_HOST empty in development: codes are printed in the API terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mecca Bakeries <no-reply@meccabakeries.com>

# Used once by db:seed to create the first super admin
SEED_ADMIN_EMAIL=areejabumuhfouz@gmail.com
SEED_ADMIN_NAME=أريج أبو محفوظ
