{
  "expo": {
    "name": "مخابز مكة",
    "slug": "mecca-bakeries",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supportsRTL": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meccabakeries.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يُسجَّل موقع التسليم لحظة تأكيد السائق فقط."
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.meccabakeries.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "versionCode": 1,
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يُسجَّل موقع التسليم لحظة تأكيد السائق فقط."
        }
      ]
    ],
    "scheme": "meccabakeries",
    "description": "تطبيق مخابز مكة للمطاعم والسائقين: طلب اليوم، الفواتير وكشف الحساب، وتأكيد التسليم.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
